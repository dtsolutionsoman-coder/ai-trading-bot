# Copy to deploy/env and fill in. Loaded by systemd services.
# NEVER commit the real env file; it stays only on the server.
#
# NOTE: config.json already carries the GLM key and is used by default.
# Only UNCOMMENT these to override it — a placeholder left active here
# would shadow the working key (env vars take precedence).

# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_API_KEY=your-key
# LLM_MODEL=glm-5.3
# LLM_THINKING=low

# Signed testnet orders (phase 2b) — only needed for --exec testnet
# HL_PRIVATE_KEY=put-wallet-private-key-here
